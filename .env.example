# Copy to .env and fill in real values. Never commit .env.
# .env is for local development only. Production values for a Prisma Compute
# deploy go in .env.compute (also gitignored; see prisma.compute.ts and the
# README's Deployment section), never in .env.

# Canonical site URL used for metadata, sitemap, and JSON-LD. Optional:
# defaults to https://portfolio-mamun.vercel.app.
NEXT_PUBLIC_SITE_URL="https://portfolio-mamun.vercel.app"

# Optional until the backend lands: the site is static and nothing imports the
# Prisma client yet. src/server/db.ts requires it once a DAL module uses it.
# Local PostgreSQL connection string. The database user needs CREATEDB so
# `prisma migrate dev` can create its shadow database. Migrations enable the
# `citext` extension, which PostgreSQL 13+ lets any database owner create.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/next_app_prisma?schema=public"
NODE_ENV=production
