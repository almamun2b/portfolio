# Copy to .env and fill in real values. Never commit .env.
# .env is for local development only. Production values for a Prisma Compute
# deploy go in .env.compute (also gitignored; see prisma.compute.ts and the
# README's Deployment section), never in .env.

# Canonical site URL used for metadata, sitemap, and JSON-LD. Optional:
# defaults to https://portfolio-mamun.vercel.app.
NEXT_PUBLIC_SITE_URL="https://portfolio-mamun.vercel.app"

# Required for the admin area (/admin). The public site is static and builds
# without it; the Prisma client connects on first use.
# Local PostgreSQL connection string. The database user needs CREATEDB so
# `prisma migrate dev` can create its shadow database. Migrations enable the
# `citext` extension, which PostgreSQL 13+ lets any database owner create.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/next_app_prisma?schema=public"
NODE_ENV=production

# --- Admin authentication (Auth.js) ---------------------------------------
# Signs and encrypts the session cookie. At least 32 random bytes:
#   openssl rand -base64 48
AUTH_SECRET=""
# Set to true when running behind a reverse proxy (Vercel, containers).
AUTH_TRUST_HOST=false

# --- Default admin, created by `pnpm db:seed` ------------------------------
# The seed creates this account once and never changes an existing one.
# Leave SEED_ADMIN_PASSWORD empty to generate a strong password that is
# printed once. Minimum 8 characters when set. Change it after first sign-in.
SEED_ADMIN_EMAIL="admin@gmail.com"
SEED_ADMIN_NAME="Site Admin"
SEED_ADMIN_PASSWORD="password"
# SEED_ADMIN_RESET=true resets an existing admin's password on the next seed.
# SEED_ADMIN_RESET=false

# --- Tooling (all optional; validated in src/env.ts) -----------------------
# Playwright e2e (pnpm test:e2e). BASE_URL points the tests at a running server
# instead of the standalone build. The admin flows run only when both E2E_*
# values are set to an account that exists (CI seeds one).
# BASE_URL="http://localhost:3000"
# E2E_ADMIN_EMAIL=""
# E2E_ADMIN_PASSWORD=""
# Sign-in for `pnpm screenshots` when a project's capture needs a login.
# CAPTURE_EMAIL=""
# CAPTURE_PASSWORD=""
