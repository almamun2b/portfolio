# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# db (generated prisma client)
/src/generated

# mcp / local agent config
opencode.jsonc
.claude/settings.local.json

# impeccable's prebuilt binaries (~16 MB each): install with the skill's own
# tooling instead of committing them.
/.agents/skills/impeccable/scripts/bin/
/.claude/skills/impeccable/scripts/bin/

# impeccable local state
/.impeccable/*.local.json
/.impeccable/hook.*.json

# Playwright
/test-results/
/playwright-report/
/blob-report/
